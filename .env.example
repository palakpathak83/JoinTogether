# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MONGODB_URI: MongoDB connection string (MongoDB Atlas or local MongoDB instance).
MONGODB_URI=

# MONGODB_DB_NAME: Database name used by the app (created on first write).
MONGODB_DB_NAME=jointogether

# CLIENT_URL: Optional comma-separated allowed frontend origins for CORS (e.g. Vercel URL).
CLIENT_URL=

# ADMIN_BOOTSTRAP_PASSCODE: Optional passcode required to claim initial SUPER_ADMIN role.
ADMIN_BOOTSTRAP_PASSCODE=

# PORT: Server port (defaults to 3000).
PORT=3000

# VITE_API_URL: Optional API base URL when frontend is hosted separately on Vercel.
VITE_API_URL=
